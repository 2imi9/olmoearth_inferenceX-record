   "land_cover_classes": {
    "1": "bare",
    "2": "burnt",
    "3": "crops",
    "4": "fallow/shifting cultivation",
    "5": "grassland",
    "6": "Lichen and moss",
    "7": "shrub",
    "8": "snow and ice",
    "9": "tree",
    "10": "urban/built-up",
    "11": "water",
    "12": "wetland (herbaceous)"
   },
   "nodata_value": 0
  },
