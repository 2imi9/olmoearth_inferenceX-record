    },
    "2": {
     "name": "pre_class",
     "description": "Argmax class of the pre/same change-category head (see table below)."
    },
    "3": {
     "name": "post_class",
     "description": "Argmax class of the post change-category head (see table below)."
    },
    "4": {
     "name": "src_class",
     "description": "Argmax source land cover class (see table below)."
    },
    "5": {
     "name": "dst_class",
     "description": "Argmax destination land cover class (see table below)."
    },
    "6": {
     "name": "pre_score",
     "description": "Probability (0-255) of the argmax class in band 2."
    },
    "7": {
     "name": "post_score",
     "description": "Probability (0-255) of the argmax class in band 3."
    },
    "8": {
     "name": "ts_pre_month",
     "description": "Predicted change start (last pre-change date), month-encoded."
    },
    "9": {
     "name": "ts_post_month",
     "description": "Predicted change end (change complete date), month-encoded."
    }
   }
  },
